graph LR
  H["Host<br/>reads one JSON object per line"]:::input
  O["stdout<br/>the protocol lane"]:::decision
  E["stderr<br/>the free lane"]:::store
  S["Server process"]:::model
  P["print with a newline<br/>line dropped, parse error logged"]:::risk
  X["print with no newline<br/>glued to the next reply<br/>the reply is lost"]:::risk
  L["Log line, safely ignored<br/>by the protocol"]:::output

  S --> O --> H
  S --> E --> L
  S -.->|"stray write"| P --> O
  S -.->|"stray partial write"| X --> O
