graph TD
  P["Paused run<br/>waiting for approval"]:::risk
  C["Checkpoint on disk<br/>named by thread_id"]:::store
  A{"Administrator<br/>approves?"}:::decision
  RUN["Run the tool and<br/>carry on the loop"]:::output
  E["Send an is_error<br/>tool result"]:::risk
  B["Audit trail on disk<br/>one row per decision"]:::store
  X["Tests that run<br/>without the model"]:::decision

  P --> C
  C -->|"resume by thread_id"| A
  A -->|"approve"| RUN
  A -->|"reject"| E
  RUN -.-> B
  E -.-> B
  X -.->|"tests"| C
  X -.->|"tests"| B

