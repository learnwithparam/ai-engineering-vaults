graph TD
  E["A call or a check failed"]:::input
  K{"Classify the failure"}:::decision
  P["Non-retryable<br/>the loan breaks policy"]:::risk
  F["Repairable<br/>the quote breaks a validator"]:::model
  N["Transient<br/>a timeout or rate limit"]:::store
  O["Stop and send it<br/>to a loan officer"]:::risk
  B["Send the errors back<br/>to the model"]:::model
  W["Wait with jittered<br/>backoff, then call again"]:::store
  G["Give up after<br/>MAX_ATTEMPTS"]:::risk
  T["Tests that run<br/>without the model"]:::decision

  E --> K
  K --> P
  K --> F
  K --> N
  P --> O
  F --> B
  N --> W
  W -->|"no attempts left"| G
  T -.->|"tests"| K

