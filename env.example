# ai-engineering-vaults
# Copy to .env and fill in. `make setup` does this for you.

# ---------------------------------------------------------------------------
# REQUIRED. One key runs every vault.
# Get one at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-key-here

# ---------------------------------------------------------------------------
# Models. Ids are variables everywhere, never literals in a notebook, so you
# can swap provider or model without editing a lesson.
# Prices and context lengths are NOT written here. Run `make probe` and read
# build/provider-truth.json, which asks the provider what is actually true.
# ---------------------------------------------------------------------------

# Default. Fast, cheap, reliable at tool calling, supports structured outputs.
# Measured: a one tool call round trip cost 33 in / 14 out tokens.
VAULT_MODEL=google/gemini-2.5-flash-lite

# A reasoning model, used only where the reasoning itself is the lesson.
# Measured: the same call cost 56 in / 219 out, because it thinks first.
# That gap is the point, and vault 3 measures it rather than asserting it.
VAULT_MODEL_REASONING=openai/gpt-5-nano

# Deliberately weaker and cheaper. Used where a small model is the right call,
# such as summarising history during compaction.
VAULT_MODEL_SMALL=mistralai/mistral-nemo

# ---------------------------------------------------------------------------
# Execution mode.
#   replay  reads committed fixtures. No key needed, no spend. This is CI.
#   live    calls the real API and costs money.
# ---------------------------------------------------------------------------
VAULT_MODE=replay

# ---------------------------------------------------------------------------
# OPTIONAL. Only if you want to call Google directly instead of through
# OpenRouter. No vault requires it.
# Get one at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# GOOGLE_API_KEY=
